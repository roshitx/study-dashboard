{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ut-study-assistant",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "study-auth-local",
      "migrations_dir": "migrations-auth"
    },
    {
      "binding": "METADATA_DB",
      "database_name": "study-metadata-local",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "VAULT_TEST_BUCKET",
      "bucket_name": "study-vault-interop"
    }
  ],
  "env": {
    "staging": {
      "name": "study-dashboard-staging",
      "vars": {
        "VAULT_TEST_WRITES": "enabled"
      },
      "routes": [
        {
          "pattern": "study-staging.roshit.id",
          "custom_domain": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "VAULT_TEST_BUCKET",
          "bucket_name": "study-vault-interop"
        },
        {
          "binding": "VAULT_HISTORY_BUCKET",
          "bucket_name": "study-vault-interop-history"
        }
      ],
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "study-auth-staging",
          "database_id": "187cdd51-1e7f-4938-94db-568745aa0317",
          "migrations_dir": "migrations-auth"
        },
        {
          "binding": "METADATA_DB",
          "database_name": "study-metadata-staging",
          "database_id": "ed780c14-6a0f-48ce-9271-379e07c8bcb5",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
