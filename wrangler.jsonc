{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ut-study-assistant",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "study-auth-local",
      "migrations_dir": "migrations-auth"
    }
  ]
}
