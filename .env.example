# Nama konfigurasi auth Worker; salin ke .dev.vars lokal (bukan VITE_*).
# Jangan menambah password vault sebagai env server atau VITE_*.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
AUTH_OWNER_EMAIL=
# AUTH_DB: binding D1 lokal dari wrangler.jsonc; session berlaku 8 jam.
# HTTP hanya literal localhost/127.0.0.1/::1; staging wajib HTTPS + Secure cookie.
# R2/D1 kelak memakai binding Wrangler (lihat docs/ARCHITECTURE.md).
